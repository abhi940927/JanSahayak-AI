# ==============================================================================
# JANSAHAYAK AI - MASTER ENVIRONMENT VARIABLES CONFIGURATION (EXAMPLE TEMPLATE)
# ==============================================================================
# Copy this file to .env in root or respective folders and populate with your credentials.
# NEVER commit real .env files with actual credentials to GitHub or version control.

# ------------------------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key-for-backend-only
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# BACKEND (NODE.JS / EXPRESS)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# ------------------------------------------------------------------------------
# OUTBOUND MAILER SERVICE (REAL EMAIL DELIVERY)
# ------------------------------------------------------------------------------
# Option 1: Gmail SMTP (Requires a 16-character Google App Password from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=JanSahayak AI Redressal <your_email@gmail.com>

# Option 2: Resend API (Alternative: free API key from https://resend.com)
RESEND_API_KEY=
RESEND_FROM=JanSahayak AI <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# FRONTEND (REACT / VITE)
# ------------------------------------------------------------------------------
# Prefix with VITE_ to expose to frontend code
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
VITE_API_URL=http://localhost:5001/api
VITE_AI_SERVICE_URL=http://localhost:8000/api/ai

# ------------------------------------------------------------------------------
# AI MICROSERVICE (PYTHON / FASTAPI)
# ------------------------------------------------------------------------------
PYTHON_ENV=development
AI_PORT=8000
AI_HOST=0.0.0.0
LLM_PROVIDER=openai # Options: openai | gemini | mock
OPENAI_API_KEY=
GEMINI_API_KEY=
MODEL_NAME=all-MiniLM-L6-v2
